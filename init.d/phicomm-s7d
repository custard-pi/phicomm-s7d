#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/phicomm-s7d
CONFIG=/etc/phicom-s7/config.json

start_service() {
    # A service has no interactive terminal: reject invalid configuration.
    [ -x "$PROG" ] || return 1
    if ! "$PROG" --check-config --config "$CONFIG" >/dev/null; then
        echo "Configure first: $PROG --configure --config $CONFIG" >&2
        return 1
    fi

    procd_open_instance
    procd_set_param command "$PROG" --config "$CONFIG"
    procd_set_param file "$CONFIG"
    # Go requires an IANA timezone name. OpenWrt stores it in zonename.
    local timezone
    timezone=$(uci -q get system.@system[0].zonename || :)
    if [ -n "$timezone" ]; then
        procd_set_param env "TZ=$timezone"
    fi
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
